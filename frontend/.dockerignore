# kaniko and docker read .dockerignore from the build context root, and the
# frontend is its own context (scripts/build-image.sh, and the Jenkins
# helmCharts.kaniko call). The repo-root .dockerignore does not apply here.
#
# node_modules matters for correctness, not just speed: the Dockerfile runs
# pnpm install and then COPY . ., so an uploaded host node_modules would
# overwrite the freshly installed one.
.git
.pnpm-store
node_modules
test-results
playwright-report
dist
