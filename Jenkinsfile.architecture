// Generates IoTSupport's deployed architecture model from the production device fleet, validates
// it and the hand-authored models against the architecture service, and archives them as the
// producer's artifact, which AaC/Architecture collects.
//
// The monorepo is one producer, iotsupport-app: backend/docs/architecture/architecture.yaml, the
// generated backend/docs/architecture/deployed-architecture.yaml and
// frontend/docs/architecture/*.yaml all declare it, and AaC/Architecture collects them together as
// that producer's artifact. The deployed model is generated on every build and never committed:
// the generator reads the production IoT Support API with the OpenBao OIDC client credentials.
//
// Controller config:
//   - Job: AaC/IoTSupport
//   - SCM: pvginkel/IoTSupport, branch main
//   - Script Path: Jenkinsfile.architecture

library identifier: 'JenkinsPipelineUtils', changelog: false

pipeline {
    agent {
        kubernetes {
            inheritFrom 'jenkins-agent'
            yaml podYaml(templates: ['aac-tools'], images: [[image: 'registry:5000/python', name: 'python']])
        }
    }

    options {
        disableConcurrentBuilds(abortPrevious: true)
        skipDefaultCheckout()
        timeout(time: 60, unit: 'MINUTES')
        timestamps()
    }

    triggers {
        githubPush()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Generate architecture (backend)') {
            steps {
                dir('backend') {
                    container('python') {
                        sh 'pip install --quiet -r ./tools/requirements.txt'
                        withVault([vaultSecrets: [
                            [path: 'kv/jenkins/iotsupport-pipeline-oidc', engineVersion: 2, secretValues: [
                                [envVar: 'IOTSUPPORT_CLIENT_ID', vaultKey: 'client_id'],
                                [envVar: 'IOTSUPPORT_CLIENT_SECRET', vaultKey: 'client_secret'],
                            ]],
                        ]]) {
                            sh '''
                                IOTSUPPORT_API_URL=https://iot.ginbov.nl \\
                                IOTSUPPORT_TOKEN_URL=$KEYCLOAK_OIDC_TOKEN_URL \\
                                ./tools/gen-architecture.py \\
                                    --dataset-url https://architecture.webathome.org/data/v0.1/architecture.json
                            '''
                        }
                    }
                }
                script {
                    architectureProducer.archive(files: ['backend/docs/architecture/deployed-architecture.yaml'])
                }
            }
        }

        // firmware-products.yaml is the generator's input, not a model: it is neither validated
        // nor archived.
        stage('Validate architecture (backend)') {
            steps {
                script {
                    architectureProducer.validate(files: [
                        'backend/docs/architecture/architecture.yaml',
                        'backend/docs/architecture/deployed-architecture.yaml',
                    ])
                    architectureProducer.archive(files: ['backend/docs/architecture/architecture.yaml'])
                }
            }
        }

        stage('Validate architecture (frontend)') {
            steps {
                script {
                    architectureProducer.validate(files: ['frontend/docs/architecture/*.yaml'])
                    architectureProducer.archive(files: ['frontend/docs/architecture/*.yaml'])
                }
            }
        }
    }
}
