# One-command dev startup: `scripts/dev.py` (honcho launcher — clean child cleanup +
# per-service logs under logs/). Lower-level: `poetry run honcho -f Procfile.dev start`.
# The backend runs in debug mode (Werkzeug auto-reload). The frontend dev server
# proxies API calls to the backend on :3101 (override with BACKEND_URL) and SSE to
# the gateway on :3102. The gateway is the `ssegateway` package (a frontend
# devDependency, github:pvginkel/SSEGateway#stable) — no sibling checkout needed.
# Each service runs in the modern-app tool container; honcho itself runs in the
# dev container.
backend:  cd backend && cexec modern-app PORT=3101 poetry run dev
frontend: cd frontend && cexec modern-app pnpm dev
gateway:  cexec modern-app scripts/dev-sse-gateway.sh
