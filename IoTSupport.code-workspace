{
  "folders": [
    {
      "path": "."
    }
  ],
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Claude",
        "type": "shell",
        "command": "kc session --ui --attach",
        "options": {
          "cwd": "/work"
        },
        "icon": {
          "id": "sparkle"
        },
        "problemMatcher": [],
        "presentation": {
          "panel": "new",
          "reveal": "always",
          "focus": true,
          "showReuseMessage": false,
          "close": true
        },
        "runOptions": {
          "reevaluateOnRerun": true,
          "instanceLimit": 999
        },
        "isBackground": true
      },
      {
        "label": "Dev Services",
        "type": "shell",
        "command": "scripts/dev.py",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "icon": { "id": "server-process" },
        "problemMatcher": [],
        "presentation": {
          "panel": "dedicated",
          "reveal": "always",
          "focus": true,
          "showReuseMessage": false
        },
        "isBackground": true
      },
      {
        "label": "Build All",
        "type": "shell",
        "command": "kc project build",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "icon": { "id": "build" },
        "problemMatcher": [],
        "presentation": {
          "panel": "dedicated",
          "reveal": "always",
          "focus": true,
          "showReuseMessage": false
        }
      }
    ]
  }
}